<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.mojang.minecraftpe" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slime">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Slime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Disabled until the version-specific native bootstrap is ready.
            Keep this Activity in Slime's default process; a separate process
            would prevent the preloader and game image from sharing one address space.
        -->
        <activity
            android:name=".runtime.MinecraftActivity"
            android:enabled="false"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:excludeFromRecents="false"
            android:launchMode="standard"
            android:screenOrientation="sensorLandscape"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:theme="@style/Theme.Slime" />
    </application>
</manifest>
